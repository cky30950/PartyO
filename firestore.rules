rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'cky30950@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /parties/{partyId} {
      // 持有高熵活動連結的訪客可檢視活動與費用紀錄
      allow read: if partyId.size() >= 8;

      // 只有主辦人管理員可以建立或刪除活動
      allow create, delete: if isAdmin() && partyId.size() >= 8;

      // 主辦人可修改任何欄位；一般訪客只可更新報名名單（guests）與 updatedAt
      allow update: if partyId.size() >= 8 && (
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guests', 'updatedAt'])
      );
    }
  }
}
